{
  "name": "wikieditor-without-mw",
  "version": "0.2.0",
  "repository": "github:LesBoys43/wikieditor-without-mw",
  "description": "This package allows you to use WikiEditor without the entire MediaWiki. It is the official successor to my old project, independ-wikieditor (though the code is unrelated to it, and independ-wikieditor is now archived), and it was coded using GPT-6.1 Sol.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./min": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.min.js"
    },
    "./styles.css": "./dist/styles.css",
    "./i18n/*.json": "./i18n/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "dist",
    "i18n",
    "COPYING",
    "NOTICE.md",
    "README.md",
    "tsup.config.ts",
    "tsconfig.json",
    "scripts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepack": "pnpm run typecheck && pnpm run build"
  },
  "keywords": [
    "wikieditor",
    "wikieditor-without-mw",
    "independ-wikieditor",
    "wikitext",
    "mediawiki",
    "wiki",
    "editor",
    "textarea",
    "toolbar",
    "standalone",
    "typescript"
  ],
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.0",
    "eslint-config-wikimedia": "^0.32.6",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vue-eslint-parser": "^10.4.1",
    "wikitext2html": "^1.0.6"
  }
}
