{
  "name": "wikieditor-vue",
  "version": "0.1.1",
  "repository": "github:LesBoys43/wikieditor-without-mw",
  "description": "Vue bindings of wikieditor-without-mw.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./min": {"types": "./dist/index.d.ts", "import": "./dist/index.min.js"},
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "dist",
    "COPYING",
    "NOTICE.md",
    "README.md",
    "tsconfig.json",
    "vite.config.ts",
    "scripts"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "vite build && vite build --mode min && pnpm run build:types && node scripts/copy-assets.mjs",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "prepack": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "wikieditor-without-mw": "^0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.0",
    "eslint-config-wikimedia": "^0.32.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^7.3.7",
    "vue-tsc": "^3.0.0",
    "typescript": "^5.9.3",
    "vue": "^3.3.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "vue-bindings",
    "wikieditor",
    "wikieditor-without-mw",
    "wikitext",
    "mediawiki",
    "wiki",
    "editor",
    "textarea",
    "typescript"
  ]
}
